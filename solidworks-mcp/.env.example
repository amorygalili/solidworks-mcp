# solidworks-mcp configuration.
# Copy to .env, or set these in your MCP client's server definition.

# --- required -----------------------------------------------------------------

# Semicolon-separated directories the server may WRITE into. A semicolon separates
# them because a colon is unusable next to a drive letter.
#
# There is no default, deliberately: with this unset the server has no output roots
# and every file write is refused. Reading and opening documents is unaffected.
SWMCP_ALLOWED_ROOTS=C:\cad\work;D:\exports

# --- tool surface -------------------------------------------------------------

# Highest tier registered with the MCP client: core, extended, advanced, debug, all.
# Only 'core' by default, to keep the client's tool list small. sw_search_tools
# always searches the whole catalog and reports which tier a hidden tool needs.
SWMCP_TOOL_TIER=core

# --- checkpoints (SAFE-005) ---------------------------------------------------

# Reuse a snapshot taken within this many seconds instead of taking another.
SWMCP_CHECKPOINT_DEBOUNCE_SEC=45

# Snapshots kept per document; older ones are pruned.
SWMCP_CHECKPOINT_KEEP=50

# Where snapshots go. Default is a .checkpoints folder beside each document, which
# is easy for a human to find. Point this elsewhere to keep working folders clean.
# SWMCP_CHECKPOINT_DIR=C:\cad\snapshots

# Allow destructive edits to documents that cannot be snapshotted — one with no local
# file, such as a 3DEXPERIENCE-managed document. Off by default: without a snapshot
# there is no way back.
SWMCP_ALLOW_UNCHECKPOINTED=0

# --- audit (SAFE-006) ---------------------------------------------------------

# Append-only JSONL record of every write. Defaults to ./.mcp-audit/audit.jsonl.
# SWMCP_AUDIT_PATH=C:\cad\logs\swmcp-audit.jsonl

# --- low-level access (DISC-004) ----------------------------------------------

# Required before sw_api_invoke_write will call a state-changing API member directly.
# Development only; prefer a typed operation wherever one exists.
SWMCP_ENABLE_LOWLEVEL_WRITE=0

# --- timing and resilience ----------------------------------------------------

# Ceiling for one operation. On expiry the caller is told the outcome is UNKNOWN —
# a COM call in flight cannot be cancelled, so it is not reported as a failure.
SWMCP_CALL_TIMEOUT_S=300

# Bounded retry for READ-ONLY calls when SOLIDWORKS reports it is busy. Mutations are
# never retried: a repeated extrude would leave a second body behind.
SWMCP_RETRY_ATTEMPTS=3
SWMCP_RETRY_INITIAL_S=0.15
SWMCP_RETRY_MAX_S=2.0

# How long to wait for a cross-process lock when launching SOLIDWORKS.
SWMCP_COM_LOCK_TIMEOUT_S=120

# --- references ---------------------------------------------------------------

# Cap on how many entities a reference resolution will examine before refusing.
SWMCP_MAX_CANDIDATES=2000

# --- COM binding --------------------------------------------------------------

# Generate makepy early-binding stubs. Off by default: late binding plus the
# property-or-method shim is faster to start and cannot be invalidated by a stale
# generated cache.
SWMCP_EARLY_BINDING=0

# --- development --------------------------------------------------------------

# Override where the requirements backlog is read from for coverage reporting.
# SWMCP_REQUIREMENTS_DOC=C:\path\to\solidworks-target-requirements.md
